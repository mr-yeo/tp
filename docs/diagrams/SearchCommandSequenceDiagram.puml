@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantPadding 5

box MainWindow STORAGE_COLOR
participant "m:MainWindow" as MainWindow STORAGE_COLOR_T2
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBook\nParser" as AddressBookParser LOGIC_COLOR
participant ":SearchCommand\nParser" as SearchCommandParser LOGIC_COLOR
participant "s:Search\nCommand" as SearchCommand LOGIC_COLOR
participant "r:Command\nResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Ui UI_COLOR_T1
participant "p1:PersonList\nPanel" as PersonListPanel UI_COLOR
participant "p2:ParentList\nPanel" as ParentListPanel UI_COLOR
end box

MainWindow -> LogicManager : execute(\n"search keyword")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(\n"search keyword")
activate AddressBookParser

create SearchCommandParser
AddressBookParser -> SearchCommandParser
activate SearchCommandParser

SearchCommandParser --> AddressBookParser
deactivate SearchCommandParser

AddressBookParser -> SearchCommandParser : parse("keyword")
activate SearchCommandParser

create SearchCommand
SearchCommandParser -> SearchCommand : SearchCommand(\nPersonPredicate,\nParentContactPredicate)
activate SearchCommand

SearchCommand --> SearchCommandParser :
deactivate SearchCommand

SearchCommandParser --> AddressBookParser : s
deactivate SearchCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
SearchCommandParser -[hidden]-> AddressBookParser
destroy SearchCommandParser

AddressBookParser --> LogicManager : s
deactivate AddressBookParser

LogicManager -> SearchCommand : execute(m)
activate SearchCommand

SearchCommand -> Model : updateFilteredPersonList(\nPersonPredicate)
activate Model

Model --> SearchCommand
deactivate Model

SearchCommand -> Model : updateParentList(\nParentContactPredicate)
activate Model

Model --> SearchCommand
deactivate Model

create CommandResult
SearchCommand -> CommandResult
activate CommandResult

CommandResult --> SearchCommand
deactivate CommandResult

SearchCommand --> LogicManager : r
deactivate SearchCommand

MainWindow <--LogicManager
deactivate LogicManager

MainWindow -> PersonListPanel : setKeyword(keyword)
activate PersonListPanel

MainWindow <-- PersonListPanel
deactivate PersonListPanel

MainWindow -> ParentListPanel : setKeyword(keyword)
activate ParentListPanel

MainWindow <-- ParentListPanel
deactivate ParentListPanel

@enduml
